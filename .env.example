MEDITRON_DEMO=1
MEDITRON_SCHEDULER=1
MEDITRON_DB_URL=sqlite:///./meditron.db
# Set only after starting your local model server:
# MEDITRON_LLM_URL=http://127.0.0.1:11434/v1
MEDITRON_LLM_MODEL=meditron-gigachat
MEDITRON_LLM_PROVIDER=local
# Chat uses conservative fast paths + read-only patient tools + the selected model.
# Old MEDITRON_CHAT_MODE=router/generative settings are no longer required.
MEDITRON_LLM_FORMAT=ollama
MEDITRON_LLM_TIMEOUT=180
# MEDITRON_LLM_API_KEY=
# MEDITRON_VAPID_KEY=/absolute/path/to/vapid.pem
# MEDITRON_VAPID_SUBJECT=mailto:admin@your-domain.ru

# Ollama: retain weights between messages and load them when Meditron starts.
MEDITRON_LLM_KEEP_ALIVE=30m
MEDITRON_LLM_PRELOAD=1

# Cloud comparison: add the authorization key locally, never in JavaScript or Git.
# To switch the web chat explicitly: MEDITRON_LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
